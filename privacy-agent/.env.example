# Copy to .env and fill using your secret manager; never commit live values.
PRIVACY_DATA_DIR=/app/data
PRIVACY_OIDC_ISSUER=https://accounts.google.com
PRIVACY_ALLOWED_SUBJECTS=[]
PRIVACY_SESSION_MINUTES=30
# JSON list of Fernet keys, ACTIVE FIRST; generate outside Git.
PRIVACY_VAULT_KEYS=
PRIVACY_ENABLE_EXTERNAL_SEARCH=0
BRAVE_SEARCH_API_KEY=

# Identification Google initiale seulement, aucun accès aux données.
# Activer exclusivement via google_setup.py --identity-setup avec une allowlist vide.
PRIVACY_IDENTITY_SETUP=0
