# Copy to secrets.toml (ignored by Git); fill through a secret manager.
[auth]
redirect_uri = "https://private-app.example.org/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://identity.example.org/.well-known/openid-configuration"
[auth.client_kwargs]
prompt = "login"
